<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Memory" Version="4.6.3" />
  </ItemGroup>
  <ItemGroup>
    <!-- Варианты recovery-хуков взаимно исключают друг друга: по умолчанию (EnableRecovery не задан) — recovery. -->
    <Compile Remove="Parser.Recovery.cs" />
    <Compile Remove="Parser.NoRecovery.cs" />
    <Compile Include="Parser.Recovery.cs" Condition="'$(EnableRecovery)' != 'false'" />
    <Compile Include="Parser.NoRecovery.cs" Condition="'$(EnableRecovery)' == 'false'" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Regex\Regex\Regex.csproj" />
  </ItemGroup>
  <Import Project="..\Shared\Shared.projitems" Label="Shared" />
</Project>