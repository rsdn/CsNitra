PreprocessorFile = Line*;

Line =
    | DirectiveLine
    | CodeLine;

DirectiveLine = "#" Directive;

Directive =
    | If
    | Elif
    | Else
    | EndIf
    | Define
    | Undef
    | Error
    | Warning
    | LineDir
    | Region
    | EndRegion
    | Pragma
    | Nullable
    | Shebang
    | BadDirective;

If = "if" Condition LineEnd;

Elif = "elif" Condition LineEnd;

Else = "else" LineEnd;

EndIf = "endif" LineEnd;

Define = "define" Symbol LineEnd;

Undef = "undef" Symbol LineEnd;

Error = "error" LineEnd;

Warning = "warning" LineEnd;

LineDir = "line" LineEnd;

Region = "region" LineEnd;

EndRegion = "endregion" LineEnd;

Pragma = "pragma" LineEnd;

Nullable = "nullable" LineEnd;

Shebang = "!" LineEnd;

BadDirective = !KnownKeyword Symbol LineEnd;

KnownKeyword =
    | "if"
    | "elif"
    | "else"
    | "endif"
    | "define"
    | "undef"
    | "error"
    | "warning"
    | "line"
    | "region"
    | "endregion"
    | "pragma"
    | "nullable";

precedence CondUnary, CondEquality, CondLogicalAnd, CondLogicalOr;

Condition =
    | CondPrimary = CondAtom
    | CondNot     = "!" Condition : CondUnary
    | CondEq      = Condition "==" Condition : CondEquality
    | CondNotEq   = Condition "!=" Condition : CondEquality
    | CondAnd     = Condition "&&" Condition : CondLogicalAnd
    | CondOr      = Condition "||" Condition : CondLogicalOr;

CondAtom =
    | Paren = "(" Condition ")"
    | Symbol;
