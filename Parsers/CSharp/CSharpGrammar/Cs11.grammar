// Cs11.grammar — C# 11: raw-строки без $ (DeclarativeStringTerminals P3).
// Открывающий и закрывающий кавычные раны = терминал RawQuoteRun (ран ≥ 3, один [Regex]-матч).
// Почему не context("\""+, ...): движок пропускает trivia после КАЖДОГО терминального матча
// (Parser.cs ParseTerminal), поэтому OneOrMany-источник context склеивал кавычные раны,
// разделённые whitespace'ом, в один «открывающий» ран (""" """ / """\n\n""" ломались).
// Один regex-матч рана этому не подвержен.
// Закрытие: ран ≥ 3 — весь ран (включая хвост лишних кавычек) остаётся в токене (семантика
// сканера/Roslyn; CS8998/CS9000 — семантические ошибки, которые мы не эмитим).
// Контент: кавычный ран ровно 1..2 (RawQuoteContent — hand-written, категория D1: «максимальный
// ран 1..2» не выразимо декларативно — у regex нет negative lookahead, а литерал + !'"' видит
// позицию после post-terminal trivia-skip), остальное — NonQuoteText (ран [^"]+). Ран ≥ 3 не
// матчится ни одной альтернативой и проскальзывает к закрытию.
// Отклонения:
//  - кавычный ран 3..N-1 в контенте при N≥4 не матчится (категория Stage-5 raw-интерполяции:
//    нет повторения с контекстной границей, D1);
//  - закрытие принимает ран 3 при N≥4 (Roslyn: ран ≥ N) — более permisсивно, и только на
//    невалидном C# (категория D2);
//  - newline-прозрачность (глобальный trivia-сканер) — D2: raw-newline в single-line (у
//    сканера reject) и пустое multi-line тело (CS9002) становятся accept; // и /* */ в
//    контенте съедаются trivia (территория T6.2 no-trivia маркера).

RawStringLiteral = RawQuoteRun RawLiteralPart* RawQuoteRun;

RawLiteralPart =
    | Quote = RawQuoteContent
    | Text = NonQuoteText;

// === Подключение к Primary (T0.3: повторное имя = добавление альтернатив) ===
Primary =
    | RawStringLiteral;
