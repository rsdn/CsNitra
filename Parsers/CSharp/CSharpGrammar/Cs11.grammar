// Cs11.grammar — C# 11: raw-строки без $ (DeclarativeStringTerminals P3).
// RawStringLiteral = одно целое RawString (ручной терминал, CSharpTerminals.cs): открытый ран
// N >= 3 (максимальный лидирующий ран), контент, закрывающий ран = ПЕРВЫЙ ран длины >= N
// (весь ран — семантика сканера/Roslyn; CS8998/CS9000 — семантические ошибки, которые мы не
// эмитим). Пустое тело невозможно по построению: открывающий ран максимален, поэтому первая
// кавычка контента отделена от него не-кавычкой ("""""" = open 6, unterminated — сканер: -1).
// Почему не context("\""+, ...): движок пропускает trivia после КАЖДОГО терминального матча
// (Parser.cs ParseTerminal), поэтому OneOrMany-источник context склеивал кавычные раны,
// разделённые whitespace'ом, в один «открывающий» ран (""" """ / """\n\n""" ломались).
// Один матч (ручной скан) этому не подвержен; в отличие от прежнего regex'а скан НЕ поглощает
// кавычные раны 3+ в контенте: две подряд идущие raw-строки — два отдельных литерала.
// Кавычный ран 1..N-1 в контенте — легальный контент (закрывает только ран >= N) — как у сканера.
// Отклонения:
//  - newline-прозрачность (глобальный trivia-сканер) — D2: raw-newline в single-line (у
//    сканера reject) и пустое multi-line тело (CS9002) становятся accept.

RawStringLiteral = RawString;

// === Interpolated raw string: $"""...""" (T3.11.1, C# 11.0) ===
// Raw-интерполяция — фича C# 11 (не C# 6): вынесено из Cs6.grammar (T3.5.2), где жила
// вместе с regular/verbatim-интерполяцией. Правило и хелперы перенесены без изменений;
// подключение — к Primary (как у не-интерполированной RawStringLiteral), а не к Expression.
// D = число $, передаётся через контекстный слот: context("$"+, тело).
// Дыра = "{"-ран D..2D-1 (первые K-D скобки — литер. текст, последние D открывают):
// первая "{" — обычный литерал, остаток рана (D-1..2D-2) — RawHoleOpenBraces; закрывается
// ровно D "}" (остаток ранa возвращается в контент). Литеральные скобочные раны = 1..D-1.
// Ран >= 2D открывающих / >= D закрывающих в контенте не матчится (CS9006/CS9007).
RawInterpolatedStringLiteral = context("$"+, "\"\"\"" RawPart* "\"\"\"");

RawPart =
    | Hole = "{" RawHoleOpenBraces Expression RawFormat? "}"{n}
    | OpenBrace = RawOpenBraceLiteral
    | CloseBrace = RawCloseBraceLiteral
    | Quote1 = "\"" !"\""
    | Quote2 = "\"" "\"" !"\""
    | Text = InterpolatedRawText;

RawFormat = ":" RawFormatText;

// === Подключение к Primary (T0.3: повторное имя = добавление альтернатив) ===
Primary =
    | RawStringLiteral
    | RawInterpolatedStringLiteral;

// === Generic attribute (T3.11.2, C# 11.0) ===
// Generic attribute = an attribute whose attribute type carries a type argument list:
//   [MyAttribute<int>]   [MyAttribute<int, string>]
// Re-declares Cs1 AttributeTypeName (non-generic) with a REQUIRED type argument list, so it is
// mutually exclusive with the Cs1 non-generic alternative (longest-match, no tie). This is what
// makes generic attributes C# 11-only: at v<=10 AttributeTypeName is non-generic, so the "<" of a
// type argument list is left unconsumed and the attribute list fails.
// The type argument list is INLINED (not the Cs2 TypeArgumentList rule) because Cs11.grammar can be
// loaded without Cs2.grammar (e.g. RawStringLiteralRuleTests load only Cs1+Cs11); inlining keeps
// this rule's dependencies confined to Cs1 (ReservedKeyword, Identifier terminal, Type). The body is
// identical to Cs2 TypeArgumentList (LanguageParser.cs:6545). Roslyn: ParseAttribute
// (LanguageParser.cs:1181) -> ParseQualifiedName (7031) -> ParseSimpleName (6182): identifier +
// optional "<" TypeArgumentList ">" -> GenericName.
AttributeTypeName = !ReservedKeyword Identifier "<" (Type; ",")+ ">";

// === Required modifier (T3.11.3, C# 11.0) ===
// `required` is a CONTEXTUAL keyword (Roslyn SyntaxKindFacts.cs:1427-1428: "required" ->
// RequiredKeyword; NOT a reserved word). It is a modifier on PROPERTIES and FIELDS:
//   public required string Name { get; set; }
//   public required int Age;
// It is NOT added to ReservedKeyword (it is contextual — `int required;` / `class required { }`
// are valid C# where `required` is a plain identifier). It is APPENDED to the Cs1 FieldModifier and
// PropertyModifier unions (T0.3 merge semantics — the same pattern as `partial` in Cs2.grammar
// T3.1.3 and `this` in Cs3.grammar T3.2.4), so the merged modifiers accept `required` only at v11+.
//
// Version-purity: at v<=10 `required` is not a FieldModifier/PropertyModifier, so
// `public required string Name { get; set; }` / `public required int Age;` REJECT (the `required`
// token falls into the Type position, where the following reserved type-name / variable-declarator
// fails). At v11 the merged modifiers consume `required` and the member parses.
//
// Both the Cs1 concrete Property (block accessors, Cs1.grammar:188), the Cs3 auto-Property (auto
// accessors, Cs3.grammar:176) and the Cs1 Field (Cs1.grammar:148) go through `PropertyModifier*` /
// `FieldModifier*`, so `public required string Name { get; set; }` (Cs3 auto-property) and
// `public required int Age;` (Cs1 field) both parse at v11. Per-modifier legality (e.g. `required`
// is not valid on interface members / abstract properties / methods) is a BINDER concern
// (parser-vs-binder split, consistent with T3.1.3 / T3.8.6).
//
// Roslyn refs (C:\RSDN\roslyn, main, src/Compilers/CSharp/Portable):
//   LanguageParser.cs GetModifierExcludingScoped (1286-1344): IdentifierToken +
//   ContextualKind.RequiredKeyword -> DeclarationModifiers.Required (1331-1332), inside the generic
//   any-order ParseModifiers loop (1347).
//   ModifierUtils.cs:352-353 (Required -> text), :409-410 (RequiredKeyword -> Required),
//   :113 (checkFeature(Required, IDS_FeatureRequiredMembers)).
//   MessageID.cs:549 (IDS_FeatureRequiredMembers) -> LanguageVersion.CSharp11 (:560).
//   DeclarationTreeBuilder.cs:1050 (modifiers.Any(RequiredKeyword)).
//   Syntax tests: MemberDeclarationParsingTests.cs (N(SyntaxKind.RequiredKeyword), e.g. 1166/1222).
FieldModifier =
    | "required";

PropertyModifier =
    | "required";

// === params Span<T> / params ReadOnlySpan<T> (T3.11.4, C# 11.0) ===
// In C# 11 the `params` modifier accepts Span<T> and ReadOnlySpan<T> (not just arrays). In Roslyn
// this is a BINDER change (SourceComplexParameterSymbol.cs:1720-1723, IDS_FeatureParamsCollections /
// FirstClassSpan -> C# 11; :1747 ERR_ParamsMustBeCollection), NOT a parser change: the parser
// (LanguageParser.cs:4938 ParseParameter -> ParseType, 4958) accepts `params <any type>` in every
// version. For version purity the Cs1 base ParamsType (Cs1.grammar) excludes `Span<...>` /
// `ReadOnlySpan<...>` via negative lookaheads, so v<=10 REJECTS them; this Cs11 alternative
// (T0.3 append-merge onto Cs1 ParamsParameter) ACCEPTS them at v11. The type-argument list is
// INLINED (not the Cs2 TypeArgumentList rule) because Cs11.grammar can be loaded without
// Cs2.grammar (RawStringLiteralRuleTests load only Cs1+Cs11). `Span`/`ReadOnlySpan` are plain
// identifiers (whole-word literals), not keywords.
ParamsParameter = "params" SpanOrReadOnlySpan "<" (Type; ",")+ ">" TypeName;

SpanOrReadOnlySpan =
    | "Span"
    | "ReadOnlySpan";
