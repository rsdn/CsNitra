// Cs11.grammar — C# 11: raw-строки без $ (DeclarativeStringTerminals P3).
// RawStringLiteral = одно [Regex]-целое RawString: открытый ран 3+ кавычек, контент, где
// каждая кавычка — часть рана 1..2 (альтернативы: одиночная " | "" + не-кавычка), контент
// >= 1 ("""""" = пустое тело — reject, как у сканера), закрывающий ран 3+ (весь ран —
// семантика сканера/Roslyn; CS8998/CS9000 — семантические ошибки, которые мы не эмитим).
// Почему не context("\""+, ...): движок пропускает trivia после КАЖДОГО терминального матча
// (Parser.cs ParseTerminal), поэтому OneOrMany-источник context склеивал кавычные раны,
// разделённые whitespace'ом, в один «открывающий» ран (""" """ / """\n\n""" ломались).
// Один regex-матч этому не подвержен (Nitra-паттерн (!"""+ Any)+ без lookahead-эквивалента).
// Кавычный ран 3..N-1 в контенте при N>=4 матчится как кавычные части — как у сканера.
// Отклонения:
//  - закрытие принимает ран 3 при N>=4 (Roslyn: ран >= N) — более permisсивно, и только на
//    невалидном C# (категория D2);
//  - 9 кавычек (""""""""") принимается как open 3 + content 3 + close 3 (сканер: -1,
//    пустое тело) — категория D3;
//  - newline-прозрачность (глобальный trivia-сканер) — D2: raw-newline в single-line (у
//    сканера reject) и пустое multi-line тело (CS9002) становятся accept.

RawStringLiteral = RawString;

// === Подключение к Primary (T0.3: повторное имя = добавление альтернатив) ===
Primary =
    | RawStringLiteral;
