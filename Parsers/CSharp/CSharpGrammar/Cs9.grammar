// Cs9.grammar — C# 9.0: records (T3.9.1).
//
// A record declaration is a NEW kind of type declaration (C# 9.0):
//   record Point(int X, int Y);              // positional, no body (semicolon)
//   record Point(int X, int Y) : Base;       // positional + base list
//   record Point(int X, int Y) { }           // positional + body
//   record Point(int X, int Y) : Base { }    // positional + base list + body
//   record class Point(int X, int Y);        // explicit class kind
//   record struct Point(int X, int Y);       // explicit struct kind
//
// T0.3 merge semantics: re-declaring a rule name APPENDS alternatives (declaration order across
// files). Re-declaring TypeDeclaration here APPENDS RecordDeclaration to the Cs1 union
// (Cs1.grammar:27-32). RecordDeclaration is a NEW alternative that REQUIRES the "record" contextual
// keyword (REQUIRED-new-construct), so it is MUTUALLY EXCLUSIVE with every existing TypeDeclaration
// alternative (each starts with a reserved keyword: class/struct/interface/enum/delegate, or
// Attributes? + such a keyword). "record" is NOT a reserved keyword (contextual, like "partial"
// Cs2.grammar:214-227), so no existing alternative can match it -> no equal-length tie.
//
// Roslyn refs (C:\RSDN\roslyn, main, src/Compilers/CSharp/Portable/Parser/LanguageParser.cs):
//   * ParseTypeDeclaration dispatch (1763-1787): an IdentifierToken whose ContextualKind is
//     RecordKeyword is routed to ParseMainTypeDeclaration (1780-1782).
//   * ParseMainTypeDeclaration (1789): the common parser for class/struct/interface/record/extension.
//   * tryScanRecordStart (1931-1963): eats the "record" keyword, then an optional class/struct keyword
//     (recordModifier = CurrentToken.Kind is ClassKeyword or StructKeyword ? EatToken() : null,
//     1936-1938).
//   * name = ParseIdentifierToken() (1821); typeParameters = ParseTypeParameterList() (1824).
//   * paramList (1827-1828): `CurrentToken.Kind == OpenParenToken ? ParseParenthesizedParameterList()
//     : null` — the POSITIONAL parameter list is present only when "(" follows the name.
//   * baseList (1830): ParseBaseList() (the ": Base" list).
//   * constraints (1839-1843): only when "where" (WhereKeyword) — out of scope here.
//   * body (1847-1914): `;` (semicolon, no body, 1850-1855) OR `{` members* `}` with an optional
//     trailing `;` (openBrace 1858, closeBrace 1909-1911, TryEatToken(Semicolon) 1913).
//   * constructTypeDeclaration (1965-2078), RecordKeyword case (2038-2058): builds RecordDeclaration
//     with classOrStructKeyword: recordModifier (the optional class/struct keyword).
//   * "record" is a CONTEXTUAL keyword (an IdentifierToken whose ContextualKind is RecordKeyword),
//     recognized only when the feature is enabled (1622-1627). Hence it is NOT added to
//     ReservedKeyword (it remains a valid type/identifier name, e.g. `class record { }`), consistent
//     with the "partial" treatment (Cs2.grammar:214-227).
//   * Version gate — IDS_FeatureRecords (Errors/MessageID.cs:211, :602, :609) ->
//     LanguageVersion.CSharp9 (a BINDER/semantic check). The PARSER accepts the form wherever the rule
//     exists (CS9 only, per the plan); version purity comes from the rule being Cs9-only.
//
// CS9 only.
//
// Record form (this grammar):
//   RecordDeclaration = Attributes? RecordModifier* "record" RecordKind? TypeName RecordParameterList?
//                       BaseList? RecordBody
//   * RecordKind — the optional "class"/"struct" keyword after "record" (Roslyn recordModifier).
//   * RecordParameterList — the positional parameter list `(` (param,)* `)` (empty allowed:
//     `record Point();`). Reuses Cs1 Parameter (Cs1.grammar:448). A dedicated rule because Cs1
//     ParameterList (Cs1.grammar:446) requires >= 1 element.
//   * BaseList — the existing Cs1 base list (Cs1.grammar:81, `":" (Type; ",")+`).
//   * RecordBody — a block body (`{ members }`, reusing Cs1 ClassBody, with an optional trailing ";")
//     OR a bare ";" (no body). Named union (the meta-grammar forbids `|` inside a group).
//   * Generics (`record Point<T>(...)`) are NOT modeled here (out of scope, minimal); the greedy merged
//     TypeName (Cs2.grammar:44) would consume `Point<T>` as a generic type name anyway.

// === Type declaration union: APPEND RecordDeclaration (T0.3 merge). ===
TypeDeclaration =
    | RecordDeclaration;

// === Record declaration (C# 9.0). ===
RecordDeclaration = Attributes? RecordModifier* "record" RecordKind? TypeName RecordParameterList? BaseList? RecordBody;

// The optional "class"/"struct" keyword after "record" (Roslyn tryScanRecordStart,
// LanguageParser.cs:1936-1938). Named union (the meta-grammar forbids `|` inside a group).
RecordKind =
    | "class"
    | "struct";

// The record's positional parameter list: "(" (param,)* ")" — empty allowed (`record Point();`).
// Roslyn paramList (LanguageParser.cs:1827-1828). Reuses Cs1 Parameter (Cs1.grammar:448).
RecordParameterList = "(" (Parameter; ",")* ")";

// Record body: a block ({ members }) with an optional trailing ";", OR a bare ";" (no body).
// Roslyn body/semicolon (LanguageParser.cs:1847-1914). Named union (no `|` inside a group). The block
// reuses Cs1 ClassBody (Cs1.grammar:102): records hold class-like members (fields/properties/methods/
// nested types).
RecordBody =
    | RecordBlock = ClassBody ";"?
    | ";";

// Record modifiers: type-level access + abstract/sealed/unsafe (the ClassModifier core,
// Cs1.grammar:44-51). `partial` (CS2) and `static` are excluded (boundary decision: not in the task's
// minimal record set — see progress doc).
RecordModifier =
    | "public"
    | "private"
    | "protected"
    | "internal"
    | "abstract"
    | "sealed"
    | "unsafe";

// === `with` expression (C# 9.0, record with expression, T3.9.2). ===
// A `with` expression copies a record with some properties changed:
//   var p2 = p with { X = 10 };
//   var p3 = new Point(1, 2) with { Y = 20 };
//
// Roslyn refs (C:\RSDN\roslyn, main, src/Compilers/CSharp/Portable):
//   * ParseWithExpression (Parser/LanguageParser.cs:13458-13479): `openBrace = EatToken(OpenBraceToken)`,
//     then ParseCommaSeparatedSyntaxList(allowTrailingSeparator: true, requireOneElement: false) with
//     each element = ParseExpressionCore(). Returns WithExpression(receiver, withKeyword,
//     InitializerExpression(WithInitializerExpression, openBrace, list, closeBrace)).
//   * GetOperatorExpressionKind (11785-11786): `with` is recognized as the WithExpression operator ONLY
//     when a `{` follows the `with` keyword (`token1Kind == WithKeyword && PeekToken(1) == OpenBrace`).
//   * Dispatched in the binary-expression path (11614-11615): the receiver is the left sub-expression.
//   * WithExpressionSyntax (Syntax.xml.Internal.Generated.cs:5843-5847): ExpressionSyntax expression
//     (receiver) + SyntaxToken withKeyword + InitializerExpressionSyntax initializer.
//
// The `with` expression is a POSTFIX expression: a record (primary) expression followed by
// `with { ... }`. Modeled as a PostfixOp alternative (re-declared, T0.3 append-merge, as Cs4's
// NamedInvocation / Cs6's NullConditional*), so it is applied inside PrimaryExpr = Primary PostfixOp*
// (Cs1.grammar:637). The `{ ... }` body reuses the Cs3 Initializer (Cs3.grammar:103); its
// InitializerElement (Cs3.grammar:125-127) handles both a member assignment (`X = 10`) and a plain
// expression — exactly the `with` initializer element forms.
//
// "with" is a CONTEXTUAL keyword (NOT in the Cs1 ReservedKeyword, Cs1.grammar:537-618), so it is matched
// here as a plain literal and remains a valid identifier name elsewhere (consistent with "record",
// T3.9.1). CS9 only: at v8 the WithExpr alternative is absent, so `p with { ... }` leaves the `with { }`
// unconsumed and REJECTS.
//
// Boundary: the reused Initializer uses the default (Forbidden) trailing-separator behavior, so a
// trailing comma (`p with { X = 10, }`) is rejected — a minor deviation from Roslyn
// (allowTrailingSeparator: true), acceptable for the minimal task.
PostfixOp =
    | WithExpr = "with" Initializer;

// === `init` accessor (C# 9.0, init-only setter, T3.9.3). ===
// An `init` accessor is like a `set` accessor but is only available during object initialization:
//   public int X { get; init; }
//   public int Y { get; set; init; }
//
// Roslyn refs (C:\RSDN\roslyn, main, src/Compilers\CSharp\Portable):
//   * `init` is a CONTEXTUAL keyword (NOT reserved): GetContextualKeyword
//     (Syntax/SyntaxKindFacts.cs:1419-1420, `case "init": return SyntaxKind.InitKeyword;`). Hence it
//     is matched here as a plain literal and remains a valid identifier/type name elsewhere (consistent
//     with `record`/`with`, T3.9.1/T3.9.2).
//   * `init` is a FIRST-CLASS accessor name, parsed by the SAME generic accessor parser as
//     `get`/`set`: ParseAccessorDeclaration (Parser/LanguageParser.cs:4632-4729) eats an
//     IdentifierToken (4646) and maps it via GetAccessorKind (4648, 4737-4748:
//     `SyntaxKind.InitKeyword => SyntaxKind.InitAccessorDeclaration`, 4743). The body may be a block
//     (`{`, 4683-4687), an arrow (`=>`, 4683), or a semicolon / auto form (`;`, 4688-4690).
//   * Accessor-level access modifiers are allowed (`private init;`), per the Roslyn parse test
//     (Test/Syntax/Parsing/AccessorDeclarationParsingTests.cs:511-526: an AccessorList with a
//     GetAccessorDeclaration `get;` + an InitAccessorDeclaration `private init;`).
//   * Version gate — IDS_FeatureInitOnlySetters (Errors/MessageID.cs:210, :601 `// semantic check`)
//     -> a BINDER/semantic (C# 9.0) feature; the PARSER accepts `init` wherever an accessor is parsed.
//     Version purity comes from the rule being Cs9-only.
//
// The required `init` forms (`get; init;`, `get; set; init;`) are AUTO (semicolon) accessors, so they
// belong to the Cs3 auto-property path. Re-declaring `AutoPropertyAccessorList` (append, T0.3 merge)
// ADDS the two `init` shapes to the existing 4 (Cs3.grammar:182-186); the Cs3 `Property` rule
// (Cs3.grammar:176) references it by name, so it picks up the new shapes at v9.
//
// Longest-match, no tie: for `get; init;` the new AutoGetInit (10 chars) beats the Cs3
// AutoGetterOnly (4 chars); for `get; set; init;` the new AutoGetSetInit (15 chars) beats the Cs3
// AutoGetSet (9 chars). Neither collides with the Cs3 shapes (which require `set`, not `init`).
//
// CS9 only: at v8 the two `init` shapes are absent, so `get; init;` leaves `init;` unconsumed and
// REJECTS (both the Cs3 auto list and the Cs1 all-block list fail).
//
// Boundary: block-body `init` (`init { }`) and accessor-level access modifiers (`private init`) are
// valid C# 9 but OUT OF SCOPE for the minimal task (the required tests are the auto forms only).
AutoPropertyAccessorList =
    | AutoGetInit    = "get" ";" "init" ";"
    | AutoGetSetInit = "get" ";" "set" ";" "init" ";";

// === Top-level statements (C# 9.0, T3.9.4). ===
// A top-level statement is a statement written at the top level of a file, BEFORE any type /
// namespace declaration:
//   Console.WriteLine("Hello, World!");
//   var x = 42;
//
// Roslyn refs (C:\RSDN\roslyn, main, src/Compilers\CSharp\Portable):
//   * ParseCompilationUnit (Parser/LanguageParser.cs:168) -> ParseCompilationUnitCore (180) ->
//     ParseNamespaceBody (410) with parentKind = SyntaxKind.CompilationUnit.
//   * ParseNamespaceBodyWorker (562): at the top level (isGlobal, 572) the `default` case (726-729)
//     calls ParseMemberDeclarationOrStatement(parentKind) — which parses EITHER a member declaration
//     OR a global statement. A statement result is wrapped in a GlobalStatement node (2636-2664,
//     2782, 2928, 2955) and added to the SAME `Members` list as member declarations (760).
//   * Disambiguation (584-724): `namespace`/`using`/`extern` are routed to the DIRECTIVE/member path
//     UNLESS the token after the keyword forces a statement — `using` with a following `(` (661-664,
//     a using statement) or a possible top-level using-local-declaration, `extern` that is not an
//     extern-alias directive (633-638). Everything else (an expression, a type name, a block, a
//     statement keyword) falls through to `default` and is parsed as a member-or-statement.
//   * GlobalStatementSyntax (Syntax/Syntax.xml.Internal.Generated.cs): a wrapper node holding a
//     single StatementSyntax — a top-level statement is a Statement wrapped in GlobalStatement.
//   * Version gate — IDS_FeatureTopLevelStatements -> a BINDER/semantic (C# 9.0) feature; the PARSER
//     accepts the form wherever the rule exists. Version purity comes from the rule being Cs9-only
//     (consistent with `record`/`with`/`init`, T3.9.1-3).
//
// The compilation unit is re-declared (T0.3 append-merge) to ADD a second alternative to the Cs1
// `CompilationUnit` (Cs1.grammar:3, `NamespaceMember*`):
//   CompilationUnit = NamespaceMember* | GlobalStatement* NamespaceMember*
// The two alternatives are mutually exclusive at the start of the file:
//   * a file that STARTS with a statement (an expression / `var` / a type name / a block / a
//     statement keyword) cannot be matched by `NamespaceMember*` (each NamespaceMember starts with a
//     reserved keyword: using/extern/namespace, or a type-declaration keyword) -> the first
//     alternative matches 0 members and leaves the input unconsumed -> it FAILS the full-consumption
//     check (Parser.cs:217), so the second alternative (the top-level-statements path) wins.
//   * a file that STARTS with a member (using/extern/namespace/type declaration) is matched by the
//     first alternative; the second alternative also matches (0 statements + the same members) — an
//     equal-length tie, and the FIRST alternative (Cs1, declaration order) wins (Parser.cs:296-316).
// `GlobalStatement` is a thin wrapper over `Statement` (Roslyn GlobalStatement holds one statement).
// `using` is a reserved keyword (Cs1 ReservedKeyword), so a top-level `using X;` is a UsingDirective
// (member), never a UsingStatement (which requires `(`) -> no statement/member overlap.
//
// CS9 only: at v8 the second CompilationUnit alternative is ABSENT (Cs9-only), so a file starting
// with a statement matches 0 members and REJECTS.
//
// Boundary: the minimal task covers a single statement, multiple statements, and statements followed
// by a type declaration. A statement AFTER a type declaration is rejected (the greedy `GlobalStatement*`
// stops at the first non-statement, so a trailing statement is left unconsumed — matching Roslyn's
// "top-level statements must come first" rule).

// === Compilation unit: APPEND the top-level-statements alternative (T0.3 merge). ===
CompilationUnit = GlobalStatement* NamespaceMember*;

// A top-level statement: a Statement wrapped in GlobalStatement (Roslyn GlobalStatementSyntax).
GlobalStatement = Statement;

// === Static abstract members in interfaces (C# 9.0, T3.9.5). ===
// A static abstract member is an interface member that is BOTH `static` and `abstract` — it has no
// body and a class that implements the interface MUST provide a static implementation:
//   interface IShape {
//       static abstract double Area { get; }
//       static abstract void Draw();
//   }
//
// Roslyn refs (C:\RSDN\roslyn, main, src/Compilers\CSharp\Portable):
//   * The PARSER does NOT special-case `static abstract`. ParseMemberDeclarationCore
//     (Parser/LanguageParser.cs:3238) collects ALL modifiers via the generic any-order ParseModifiers
//     loop (3259; ParseModifiers 1347, GetModifierExcludingScoped 1286), then dispatches to the
//     method/property parser by the next token. So `static abstract` is just two modifiers at the
//     parse level (no separate "static abstract" syntax node).
//   * The static+abstract-in-interface feature is a BINDER/semantic check (the plan's
//     parser-vs-binder split): MessageID.IDS_FeatureStaticAbstractMembersInInterfaces
//     (Errors/MessageID.cs:233, :546 "semantic check") -> LanguageVersion.CSharp9. Enforced by
//     ModifierUtils.CheckFeatureAvailabilityForStaticAbstractMembersInInterfacesIfNeeded
//     (Symbols/Source/ModifierUtils.cs:216-228) and
//     CheckFeatureAvailabilityForDefaultInterfaceImplementation (150-197; the static+abstract/
//     sealed/virtual combination at 161-179). SourceMemberMethodSymbol
//     (Symbols/Source/SourceMemberMethodSymbol.cs:1098-1100) and SourcePropertySymbol
//     (Symbols/Source/SourcePropertySymbol.cs:470) flag the static+abstract form.
//
// Version purity (CS9 only): `static` and `abstract` are ALREADY MethodModifiers (Cs1.grammar:293,
// :296), so the Cs1/Cs2/Cs8 InterfaceMethod (`MethodModifier* Type ...`) would otherwise ACCEPT
// `static abstract ...` at v1-v8 (verified empirically: `interface I { static abstract void Draw(); }`
// parsed at v1 before this change). To make it CS9-only, T3.9.5 restricts those three InterfaceMethod
// rules to `InterfaceMethodModifier` (Cs1.grammar, MethodModifier MINUS static/abstract), so at
// v1-v8 NO InterfaceMember alternative matches `static abstract ...` -> REJECT. At v9 the two
// Cs9-only StaticAbstractInterface* rules below are the sole matchers.
//
// Disambiguation (longest-match-wins, mutually exclusive with the existing alternatives):
//   * `static abstract void Draw();` — the Cs1/Cs2/Cs8 InterfaceMethod FAIL (InterfaceMethodModifier
//     cannot consume `static`/`abstract`, so `Type` sees the reserved `static` and fails); only
//     StaticAbstractInterfaceMethod matches. Sole match.
//   * `static abstract double Area { get; }` — the Cs1 InterfaceProperty FAIL (PropertyModifier
//     consumes `static` then `Type` sees the reserved `abstract`); only StaticAbstractInterfaceProperty
//     matches. Sole match.
//
// Boundary (out of scope for the minimal task): a static interface member WITH a body
// (`static void Draw() { }`, C# 9) and static-abstract members carrying `new`/other method modifiers
// (`new static abstract ...`) are NOT modeled; only the `static abstract` (no-body) method/property
// forms with an optional LEADING access modifier (canonical order) are accepted.
//
// === InterfaceMember: APPEND the two static-abstract alternatives (T0.3 merge). ===
InterfaceMember =
    | StaticAbstractInterfaceMethod
    | StaticAbstractInterfaceProperty;

// A static abstract interface method: optional access modifiers + `static abstract` + return type +
// name + parameter list + `;` (no body — abstract members have no body). Roslyn: the parser treats
// `static abstract` as plain modifiers (LanguageParser.cs:3259); the no-body `;` mirrors the C# 1.0
// interface method (Cs1.grammar:281) and the binder requires a static implementation.
StaticAbstractInterfaceMethod = Attributes? InterfaceAccessModifier* "static" "abstract" Type TypeName "(" ParameterList? ")" ";";

// A static abstract interface property: optional access modifiers + `static abstract` + type + name +
// semicolon accessors (no body). Mirrors the C# 1.0 interface property (Cs1.grammar:209) accessor form
// (InterfaceAccessor = AccessorName ";", Cs1.grammar:212).
StaticAbstractInterfaceProperty = Attributes? InterfaceAccessModifier* "static" "abstract" Type TypeName "{" InterfaceAccessor+ "}" ";"?;

// Access modifiers allowed on an interface member (public/private/protected/internal). Only an access
// modifier may precede the REQUIRED `static abstract` (the canonical C# order, e.g. `public static
// abstract`); other method modifiers (`new`, `virtual`, ...) are a binder concern and out of scope.
InterfaceAccessModifier =
    | "public"
    | "private"
    | "protected"
    | "internal";
