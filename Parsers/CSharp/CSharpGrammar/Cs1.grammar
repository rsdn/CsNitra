Grammar = CompilationUnit;

CompilationUnit = NamespaceMember*;

NamespaceMember =
    | UsingDirective
    | ExternAliasDirective
    | NamespaceDeclaration
    | TypeDeclaration;

UsingDirective =
    | AliasUsingDirective = "using" TypeName "=" QualifiedName ";"
    | OpenUsingDirective = "using" QualifiedName ";";

ExternAliasDirective = "extern" "alias" TypeName ";";

NamespaceDeclaration = "namespace" QualifiedName "{" NamespaceBody? "}" ";"?;

NamespaceBody = NamespaceMember*;

QualifiedName = TypeName NamespaceSegment*;

TypeName = !ReservedKeyword Identifier;

NamespaceSegment = "." TypeName;

TypeDeclaration =
    | ClassDeclaration
    | StructDeclaration
    | InterfaceDeclaration
    | EnumDeclaration
    | DelegateDeclaration;

ClassDeclaration = Attributes? ClassModifier* "class" TypeName BaseList? ClassBody ";"?;

StructDeclaration = Attributes? StructModifier* "struct" TypeName BaseList? StructBody ";"?;

InterfaceDeclaration = Attributes? InterfaceModifier* "interface" TypeName BaseList? InterfaceBody ";"?;

EnumDeclaration = Attributes? EnumModifier* "enum" TypeName EnumBaseList? "{" EnumMemberList? "}" ";"?;

DelegateDeclaration = Attributes? DelegateModifier* "delegate" Type TypeName "(" ParameterList? ")" ";";

ClassModifier =
    | "public"
    | "private"
    | "protected"
    | "internal"
    | "abstract"
    | "sealed"
    | "unsafe";

StructModifier =
    | "public"
    | "private"
    | "protected"
    | "internal"
    | "abstract"
    | "unsafe";

InterfaceModifier =
    | "public"
    | "private"
    | "protected"
    | "internal"
    | "unsafe";

EnumModifier =
    | "public"
    | "private"
    | "protected"
    | "internal";

DelegateModifier =
    | "public"
    | "private"
    | "protected"
    | "internal"
    | "unsafe";

BaseList = ":" (Type; ",")+;

EnumBaseList = ":" Type;

// === T2.1.1: member infrastructure — union rules for class/struct/interface bodies + Field.
// Class/struct bodies can contain fields and nested types; interface bodies can contain only
// nested types (C# 1.0 interfaces have NO fields — see progressT2.1.1 D1). Later sub-points
// (T2.1.2–T2.1.4) APPEND more member alternatives (Property/Method/Constructor/Operator/Indexer/
// Event); the unions are structured to be append-only.
//
// Disambiguation Field vs TypeDeclaration — longest-match: a field starts with an attribute /
// modifier / type-name (predefined or qualified) followed by an identifier; a type declaration
// starts with the class/struct/interface/enum/delegate keyword. The two are mutually exclusive at
// the "type-name vs. declaration-keyword" boundary (a declaration keyword is reserved → cannot be a
// Type/TypeName → Field fails; a type-name is never a declaration keyword → TypeDeclaration fails),
// so no equal-length tie arises.
//
// Modifier ordering: Roslyn's ParseModifiers (LanguageParser.cs:1347-1484) is a generic loop that
// consumes modifier keywords in ANY order; per-kind legality/ordering are binder diagnostics.
// Roslyn's own test code uses `static public` (Test/Semantic/Semantics/AccessCheckTests.cs:27).
// So FieldModifier* accepts any order — `static public int X;` parses (positive, not negative).
ClassBody = "{" ClassMember* "}";

StructBody = "{" StructMember* "}";

InterfaceBody = "{" InterfaceMember* "}";

ClassMember =
    | Field
    | Property
    | AbstractProperty
    | Method
    | Constructor
    | Destructor
    | Operator
    | ConversionOperator
    | Indexer
    | Event
    | TypeDeclaration;

StructMember =
    | Field
    | Property
    | AbstractProperty
    | Method
    | Constructor
    | Destructor
    | Operator
    | ConversionOperator
    | Indexer
    | Event
    | TypeDeclaration;

// Interface: nested types + properties (T2.1.2) + methods (T2.1.3) + indexers/events (T2.1.4).
// No fields in C# 1.0 (progressT2.1.1 D1).
InterfaceMember =
    | InterfaceMethod
    | InterfaceProperty
    | InterfaceIndexer
    | InterfaceEvent
    | TypeDeclaration;

// Field: attributes? modifier* type variable-declarator (, variable-declarator)* ;
// (Roslyn ParseNormalFieldDeclaration LanguageParser.cs:5200-5220 → VariableDeclaration +
// EatToken(Semicolon); declarators via ParseFieldDeclarationVariableDeclarators 5262, which loops
// on commas 5322-5359). Reuses VariableDeclarator (T2.2.1) = !ReservedKeyword Identifier ("="
// Expression)?. Field initializers are C# 1.0.
Field = Attributes? FieldModifier* Type VariableDeclarator ("," VariableDeclarator)* ";";

// C# 1.0 field modifiers: access + static/const/readonly/extern/new/volatile (Roslyn
// GetModifierExcludingScoped LanguageParser.cs:1286-1345). All core C# 1.0, no feature gate
// (volatile: 1314-1315). Excluded (version-purity / wrong kind): async (CS5), partial (CS2),
// unsafe (method/type modifier, not a field modifier), virtual/abstract/sealed/override
// (method/property modifiers, T2.1.2/T2.1.3).
FieldModifier =
    | "public"
    | "private"
    | "protected"
    | "internal"
    | "static"
    | "const"
    | "readonly"
    | "extern"
    | "new"
    | "volatile";

// === T2.1.2: properties (class/struct + interface). ===
// Accessor body forms differ by context (Roslyn ParseAccessorDeclaration LanguageParser.cs:4632-4729):
//   * CONCRETE class/struct property — accessors REQUIRE a block body: `get { ... }` / `set { ... }`.
//     C# 1.0 has NO auto-properties, so `int P { get; set; }` in a class is CS3 and must REJECT.
//   * INTERFACE property — accessors have NO body (semicolon): `get;` / `set;` (valid C# 1.0).
//   * ABSTRACT class property — accessors have NO body (semicolon): `abstract int X { get; set; }`.
// The parser cannot tell "abstract" from "concrete" at the accessor position (the `abstract` modifier
// appears earlier), so the semicolon form is gated on `abstract` via a separate AbstractProperty rule,
// while concrete Property requires a block body. This is what makes `int P { get; set; }` (auto-prop,
// CS3) REJECT while `abstract int X { get; set; }` ACCEPT — both use `get; set;`, only `abstract` differs.
// `value` (implicit setter parameter) is NOT in ReservedKeyword, so it is already a true identifier in
// expression position: `set { _x = value; }` parses with no change. `this` is a Primary alternative.
//
// Disambiguation Property vs Field (longest-match): both start `Type TypeName`; the token after the
// name disambiguates — `{` → Property, `;`/`=` → Field (VariableDeclarator). Mutually exclusive, no tie.
// Property vs AbstractProperty: mutually exclusive on accessor form (block vs semicolon) AND on the
// required `abstract` (Property's Type cannot be `abstract`; AbstractProperty requires it). No tie.

// Concrete class/struct property: accessors REQUIRE a block body (no auto-properties in C# 1.0).
// Roslyn ParsePropertyDeclaration (LanguageParser.cs:4252-4317) → ParseAccessorList (4375-4406) →
// ParseAccessorDeclaration (4632-4729, block path 4683-4687).
Property = Attributes? PropertyModifier* Type TypeName "{" AccessorDeclaration+ "}" ";"?;

// Abstract class/struct property: accessors are semicolon-terminated (no body) — the same accessor
// form as interface accessors. Requires the `abstract` modifier (binder: abstract members have no body).
// `PropertyModifier` excludes `abstract`, so the surrounding `*` loops cannot greedily consume the
// required `abstract` (boundary decision D1). Roslyn ParseAccessorDeclaration 4688-4690 (semicolon).
AbstractProperty = Attributes? PropertyModifier* "abstract" PropertyModifier* Type TypeName "{" InterfaceAccessor+ "}" ";"?;

// Accessor name: get | set. (The CsNitra meta-grammar does NOT allow `|` inside a group
// `( ... )` — a Group is `(` one RuleExpression `)` (CsNitraParser.cs:103) — so the get/set union
// is a named rule referenced by both accessor forms.)
AccessorName =
    | "get"
    | "set";

// Concrete class/struct accessor: get/set + block body.
AccessorDeclaration = AccessorName Block;

// Interface property: accessors are semicolon-terminated (no body) — valid C# 1.0
// (`int Value { get; set; }`). Roslyn ParseAccessorDeclaration 4688-4690 (semicolon accessor; the
// binder requires interface/abstract context for a body-less accessor).
InterfaceProperty = Attributes? PropertyModifier* Type TypeName "{" InterfaceAccessor+ "}" ";"?;

// Semicolon-terminated accessor (interface property / abstract class property): get/set + ";".
InterfaceAccessor = AccessorName ";";

// C# 1.0 property modifiers for class/struct: access + static/virtual/override/new/extern/sealed
// (10 keywords). `abstract` (the 11th) is handled by AbstractProperty (which requires it) because
// abstract properties use semicolon accessors, not block bodies. Ordering is NOT enforced (Roslyn
// ParseModifiers LanguageParser.cs:1347-1484 is a generic loop; SafeModifierParsingTests.Property
// uses `safe public extern` / `public extern safe` — any order). Excluded (version-purity / wrong
// kind): async (CS5), partial (CS2), unsafe (method/type modifier), const/readonly/volatile (field-only).
PropertyModifier =
    | "public"
    | "private"
    | "protected"
    | "internal"
    | "static"
    | "virtual"
    | "override"
    | "new"
    | "extern"
    | "sealed";

// === T2.1.3: methods, constructors, destructors (class/struct) + interface methods. ===
// Roslyn LanguageParser.cs (C:\RSDN\roslyn) ParseMemberDeclarationCore (3238) dispatches by the
// leading token: identifier + "(" -> ParseConstructorDeclaration (3509); "~" ->
// ParseDestructorDeclaration (3572); otherwise a return Type is parsed, then method/field/property.
//
// Disambiguation Method vs Constructor (longest-match): a method is `Type TypeName (` (TWO names
// before "("), a constructor is `TypeName (` (ONE name). A method always consumes >= one more name
// token, so they cannot match the same input at the same length -> no equal-length tie:
//   `int Foo() { }`   -> Method (Type=int, Name=Foo); Constructor fails (int is reserved, not a name).
//   `Foo() { }`       -> Constructor (Name=Foo); Method fails (needs a 2nd name before "(", sees "(").
//   `Point GetPoint()`-> Method (Type=Point, Name=GetPoint); Constructor fails (name followed by name).
//
// Disambiguation Method vs Field (longest-match): both start `Type Name`; the token after the name
// disambiguates -> "(" -> Method, ";"/","/"=" -> Field (VariableDeclarator). Mutually exclusive, no tie:
//   `int x = 5;`    -> Field (name followed by "=").
//   `int Foo() { }` -> Method (name followed by "("; Field needs ";" after the name, sees "(").
//
// Destructor form (Roslyn ParseDestructorDeclaration 3572-3587): `~` + name + EMPTY ParameterList
// ("(" ")") + block. C# destructors DO have empty parentheses -> `~C() { }` is the valid form;
// `~C { }` (no parens) is INVALID (task premise corrected by Roslyn; see Boundary decision D1).
// Attributes/modifiers before "~" are accepted (Roslyn's generic ParseModifiers 1347-1484 loop);
// per-kind legality is a binder concern (parser-vs-binder split, consistent with T2.1.1 D2).
//
// ConstructorInitializer (Roslyn TryParseConstructorInitializer 3530 / ParseConstructorInitializer
// 3544-3568): `:` + (base | this) + ArgumentList (parens required, even when empty: `: base()`).
// This ":" is distinct from a type-declaration base list (`class C : Base` -> the ":" is after the
// type name, before the "{"); no conflict: a constructor initializer only follows the constructor's
// parameter list ")".
//
// Method body: `( Block | ";" )` is NOT expressible in the CsNitra meta-grammar (no `|` inside a
// group, CsNitraParser.cs:103) -> named union MethodBody. A concrete `void Foo();` (semicolon body)
// is a BINDER error, not a parse error (T1.3.1 split), so MethodBody allows both. InterfaceMethod
// REQUIRES ";" (C# 1.0 interface methods have no body; default interface methods are CS8).
Method = Attributes? MethodModifier* Type TypeName "(" ParameterList? ")" MethodBody;

MethodBody =
    | Block
    | ";";

Constructor = Attributes? ConstructorModifier* TypeName "(" ParameterList? ")" ConstructorInitializer? Block;

ConstructorInitializer = ":" ConstructorInitializerKeyword ArgumentList;

ConstructorInitializerKeyword =
    | "base"
    | "this";

Destructor = Attributes? MethodModifier* "~" TypeName "(" ")" Block;

InterfaceMethod = Attributes? MethodModifier* Type TypeName "(" ParameterList? ")" ";";

// C# 1.0 method modifiers: access + static/virtual/override/abstract/new/extern/sealed/unsafe
// (Roslyn GetModifierExcludingScoped 1286-1345; ParseModifiers 1347-1484 is a generic any-order
// loop, so ordering is NOT enforced). `unsafe` is core C# 1.0 (no feature gate; pointer types since
// T1.4 -> `unsafe void M() { }`, `unsafe ~C() { }`). Excluded (version-purity / wrong kind):
// async (CS5), partial (CS2), readonly/volatile (field-only), ref (CS7.2).
MethodModifier =
    | "public"
    | "private"
    | "protected"
    | "internal"
    | "static"
    | "virtual"
    | "override"
    | "abstract"
    | "new"
    | "extern"
    | "sealed"
    | "unsafe";

// C# 1.0 constructor modifiers: access + extern/static/new. Roslyn's generic ParseModifiers loop
// accepts any modifier before a constructor; per-kind legality is a binder concern. `new` is valid
// on constructors (hides a base constructor). Excluded: virtual/override/abstract/sealed (not
// constructor modifiers), unsafe (not in the task's set -> see Boundary decision D3).
ConstructorModifier =
    | "public"
    | "private"
    | "protected"
    | "internal"
    | "extern"
    | "static"
    | "new";

// === T2.1.4: operators (user-defined + conversion), indexers, events (class/struct/interface). ===
// Roslyn LanguageParser.cs (C:\RSDN\roslyn):
//   * User-defined operator: ParseOperatorDeclaration (3992-4190) — [ret-type] + `operator` +
//     operator token + parenthesized param list + ( block | ";" ). The ret-type comes BEFORE
//     `operator` (it is parsed by ParseReturnType 3314 before IsOperatorStart 3335 dispatches).
//   * Conversion operator: TryParseConversionOperatorDeclaration (3760-3977) — (implicit|explicit) +
//     `operator` + target Type + param list + ( block | ";" ). Order confirmed by Roslyn
//     tests (Test/Semantic/Semantics/BetterCandidates.cs:885 `implicit operator`).
//   * Indexer: ParseIndexerDeclaration (4192-4250) — [ret-type] + `this` + [param list] +
//     accessor list (block for class/struct, semicolon for interface — same split as Property,
//     T2.1.2).
//   * Event: ParseEventDeclaration (5082-5095) — `event` + Type + name, then either a `;`
//     (ParseEventFieldDeclaration 5222) or an accessor list (ParseEventDeclarationWithAccessors
//     5097) with add/remove accessors (block bodies). Interface events are `;`-only (C# 1.0 has
//     no interface event accessors with bodies).
//
// Disambiguation (longest-match, no ties):
//   Operator vs Method: after `Type`, the `operator` keyword -> Operator, a TypeName -> Method.
//   Operator vs ConversionOperator: `Type operator ...` (ret-type first) vs
//   `(implicit|explicit) operator ...` (implicit/explicit first); mutually exclusive leading tokens.
//   Indexer vs Property: after `Type`, the `this` keyword -> Indexer, a TypeName -> Property.
//   Event vs everything: starts with the `event` reserved keyword (no other member does).
//
// OperatorSymbol set: the task's 16 C# 1.0 overloadable symbols. Roslyn's full overloadable set
// (SyntaxKindFacts.cs:487-558) is larger, but the standalone compound-assignment operators are a
// C# 14 feature (UserDefinedCompoundAssignmentOperatorsTests.cs:46-51) — see progressT2.1.4 D1.
// The meta-grammar does NOT allow `|` inside a group (CsNitraParser.cs:103), so the symbol set is
// a named union (same workaround as AccessorName T2.1.2 / ConstructorInitializerKeyword T2.1.3).
Operator = Attributes? OperatorModifier* Type "operator" OperatorSymbol "(" ParameterList ")" MethodBody;

// Conversion operator: `(implicit|explicit) operator Type (params) (Block | ";")` — the
// implicit/explicit keyword comes BEFORE `operator` (Roslyn TryParseConversionOperatorDeclaration
// eats implicit/explicit at 3837, then `operator` at 3873; confirmed by Roslyn tests e.g.
// BetterCandidates.cs:885 `public static implicit operator C(A a)`). The Type after `operator` is
// the TARGET type (e.g. `implicit operator int(A a)`). Reuses MethodBody (Block | ";").
ConversionOperator = Attributes? OperatorModifier* ConversionKind "operator" Type "(" ParameterList ")" MethodBody;

ConversionKind =
    | "explicit"
    | "implicit";

OperatorSymbol =
    | "+"
    | "-"
    | "*"
    | "/"
    | "%"
    | "&"
    | "|"
    | "^"
    | "~"
    | "<"
    | ">"
    | "=="
    | "!="
    | "++"
    | "--";

// C# 1.0 operator modifiers: access + static/extern/unsafe. `static` is REQUIRED by the binder
// (SourceUserDefinedOperatorSymbol) but NOT by the parser (Roslyn ParseModifiers is a generic loop),
// so `OperatorModifier*` is zero-or-more (a missing `static` still parses — binder rejects).
// virtual/override/abstract/sealed/new are not operator modifiers (operators are always static).
OperatorModifier =
    | "public"
    | "private"
    | "protected"
    | "internal"
    | "static"
    | "extern"
    | "unsafe";

// Indexer (class/struct): accessors REQUIRE a block body (same split as Property, T2.1.2).
// `Type "this" "[" ParameterList "]"` — the Type before `this` is the return type; `this` is a
// reserved keyword (cannot be a TypeName), so Indexer vs Property disambiguate cleanly.
Indexer = Attributes? IndexerModifier* Type "this" "[" ParameterList "]" "{" AccessorDeclaration+ "}";

// Interface indexer: accessors are semicolon-terminated (no body) — valid C# 1.0.
InterfaceIndexer = Attributes? IndexerModifier* Type "this" "[" ParameterList "]" "{" InterfaceAccessor+ "}";

// C# 1.0 indexer modifiers: like property modifiers (access + static/virtual/override/new/extern/
// sealed). `abstract` is not handled (no AbstractIndexer rule — see Boundary decision D2).
IndexerModifier =
    | "public"
    | "private"
    | "protected"
    | "internal"
    | "static"
    | "virtual"
    | "override"
    | "new"
    | "extern"
    | "sealed";

// Event (class/struct): simple `event Type Name;` OR `event Type Name { add { } remove { } }`.
// EventTail splits the two forms (`|` in a group is not expressible, CsNitraParser.cs:103).
Event = Attributes? EventModifier* "event" Type TypeName EventTail;

EventTail =
    | ";"
    | EventAccessors = "{" EventAccessor+ "}";

// Event accessor: add/remove + block body. `value` is usable in the bodies (true identifier, T2.1.2).
EventAccessor = EventAccessorName Block;

EventAccessorName =
    | "add"
    | "remove";

// Interface event: `event Type Name;` only (C# 1.0 has NO interface event accessors with bodies).
InterfaceEvent = Attributes? EventModifier* "event" Type TypeName ";";

// C# 1.0 event modifiers: access + static/abstract/new/virtual/override/sealed. Excluded: extern/
// unsafe (not event modifiers), const/readonly/volatile (field-only).
EventModifier =
    | "public"
    | "private"
    | "protected"
    | "internal"
    | "static"
    | "abstract"
    | "new"
    | "virtual"
    | "override"
    | "sealed";

EnumMemberList = (EnumMember; "," : ?)+;

EnumMember = Attributes? TypeName EnumMemberValue?;

EnumMemberValue = "=" Constant;

ParameterList = (Parameter; ",")+;

Parameter = Attributes? ParameterModifier* Type TypeName;

ParameterModifier =
    | "ref"
    | "out"
    | "params";

Attributes = AttributeList*;

AttributeList = "[" (Attribute; "," : ?)+ "]";

Attribute = AttributeName AttributeArgumentList?;

AttributeName = TypeName NamespaceSegment*;

AttributeArgumentList = "(" (AttributeArgument; ",")* ")";

AttributeArgument =
    | NamedAttributeArgument = TypeName "=" Constant
    | Constant;

Constant =
    | "true"
    | "false"
    | StringLiteral
    | VerbatimStringLiteral
    | CharLiteral
    | UnaryConstant = UnarySign Constant
    | DecimalConstant = DecimalIntegerLiteral IntegerSuffix?
    | HexConstant = HexIntegerLiteral IntegerSuffix?;

UnarySign =
    | Plus = "+"
    | Minus = "-";

// === C# 1.0: строковые литералы (декларативные; ран текста — [Regex]-терминал,
// экрани — StringEscape; закрывающая кавычка verbatim — одиночная, !'"' = guard от ""-рана).
// Расхождение newline-прозрачности (trivia съедает newline между элементами) — как в
// InterpolatedStringGrammar §7.5.
StringLiteral = "\"" StringLiteralPart* "\"";

StringLiteralPart =
    | Escape = StringEscape
    | Text = StringText;

VerbatimStringLiteral = "@\"" VerbatimLiteralPart* "\"" !'"';

VerbatimLiteralPart =
    | QuoteEscape = "\"" "\""
    | Text = NonQuoteText;

// === Типы C# 1.0 (T1.4) — семантика по Roslyn LanguageParser.ParseType/ParseTypeCore/
// ParseUnderlyingType/ParseArrayRankSpecifier/ParsePointerTypeMods (C:\RSDN\roslyn, main).
// Postfix-цикл Roslyn (LanguageParser.cs:7614-7676): после базового типа любое число и в любом
// порядке `*` (указатель) и `[...]` (ранг массива). В тип-контексте ранг-спецификатор содержит
// только запятые (размеры — только в new/stackalloc, вне скоупа). Nullable `?` (CS2) и NRT (CS8)
// не входят в C# 1.0.
// TDOPP: саморекурсивные альтернативы — postfix-операторы Type; уровни TypePointer/TypeArray
// объявлены во втором precedence-списке ниже (postfix с приоритетом 0 неприменим при
// minPrecedence=0 — Parser.cs ContinueFromPartialPostfix).
Type =
    | PredefinedType
    | QualifiedName
    | PointerType = Type : TypePointer "*"
    | ArrayType = Type : TypeArray ArrayRankSpecifier;

// 16 преопределённых типов — Roslyn SyntaxFacts.IsPredefinedType (SyntaxKindFacts.cs:316-340).
PredefinedType =
    | "bool"
    | "byte"
    | "char"
    | "decimal"
    | "double"
    | "float"
    | "int"
    | "long"
    | "object"
    | "sbyte"
    | "short"
    | "string"
    | "uint"
    | "ulong"
    | "ushort"
    | "void";

// Ранг-спецификатор в тип-контексте: `[` + n запятых + `]` = ранг n+1 (Roslyn
// ParseArrayRankSpecifier: каждая запятая добавляет размерность; `[]` = ранг 1).
ArrayRankSpecifier = "[" ","* "]";

ReservedKeyword =
    | "abstract"
    | "__arglist"
    | "as"
    | "base"
    | "bool"
    | "break"
    | "byte"
    | "case"
    | "catch"
    | "char"
    | "checked"
    | "class"
    | "const"
    | "continue"
    | "decimal"
    | "default"
    | "delegate"
    | "do"
    | "double"
    | "else"
    | "enum"
    | "event"
    | "explicit"
    | "extern"
    | "false"
    | "finally"
    | "fixed"
    | "float"
    | "for"
    | "foreach"
    | "goto"
    | "if"
    | "implicit"
    | "in"
    | "int"
    | "interface"
    | "internal"
    | "is"
    | "lock"
    | "long"
    | "__makeref"
    | "namespace"
    | "new"
    | "null"
    | "object"
    | "operator"
    | "out"
    | "override"
    | "params"
    | "private"
    | "protected"
    | "public"
    | "readonly"
    | "ref"
    | "__reftype"
    | "__refvalue"
    | "return"
    | "sbyte"
    | "sealed"
    | "short"
    | "sizeof"
    | "stackalloc"
    | "static"
    | "string"
    | "struct"
    | "switch"
    | "this"
    | "throw"
    | "true"
    | "try"
    | "typeof"
    | "uint"
    | "ulong"
    | "unchecked"
    | "unsafe"
    | "ushort"
    | "using"
    | "virtual"
    | "void"
    | "volatile"
    | "while";

// === ВРЕМЕННОЕ (T3.5.1) — T2.3 заменит на полную TDOPP-таблицу C# 1.0 ===
// T2.3.2: Cast — самый жёсткий уровень (выше Unary): каст-операнд парсится на нём, поэтому не
// поглощает бинарные операторы (см. CastExpr). Roslyn: Precedence.Cast (LanguageParser.cs:12848).
precedence
    Cast, Unary, Multiplicative, Additive, Relational, Equality,
    LogicalAnd, LogicalXor, LogicalOr, CondAnd, CondOr,
    Conditional, Assignment, Comma;

// === T1.4: уровни postfix-операторов Type (указатель, ранг массива).
// Мержится со списком выше через якорь Comma (CsNitraTypeChecker.TryMergePrecedenceList);
// на Expression не влияет (уровни Type не используются в Expression).
precedence TypeArray, TypePointer, Comma;

Expression =
    | PrimaryExpr   = Primary PostfixOp*
    | UnaryPlus     = "+"  Expression : Unary
    | UnaryMinus    = "-"  Expression : Unary
    | UnaryNot      = "!"  Expression : Unary
    | UnaryBitNot   = "~"  Expression : Unary
    | PreInc        = "++" Expression : Unary
    | PreDec        = "--" Expression : Unary
    // T2.3.2: каст — prefix-оператор на уровне Cast (самый жёсткий). Операнд — ReqRef на Cast,
    // поэтому не поглощает бинарные операторы: (int) x + y → ((int)x) + y.
    // Разграничение с (expr): PrimaryExpr (с Parens) стоит ПЕРВЫМ prefix-альтернативой, поэтому
    // longest-match + тай-брейк «первый выигрывает» дают: неоднозначные (x)/(a.b) со следующим
    // бинарным оператором → скобки (как Roslyn CanFollowCast(+/-/...)=false); неambiguous-типы
    // (int/int[]/int*) не являются началом Expression → только каст; (System.String) s — каст
    // длиннее. См. docs/CSharpParserPlan-progressT2.3.2.md.
    | CastExpr      = "(" Type ")" Expression : Cast
    | Mul           = Expression "*"  Expression : Multiplicative
    | Div           = Expression "/"  Expression : Multiplicative
    | Mod           = Expression "%"  Expression : Multiplicative
    | Add           = Expression "+"  Expression : Additive
    | Sub           = Expression "-"  Expression : Additive
    | Less          = Expression "<"  Expression : Relational
    | Greater       = Expression ">"  Expression : Relational
    | LessEq        = Expression "<=" Expression : Relational
    | GreaterEq     = Expression ">=" Expression : Relational
    // T2.3.1: is/as — RHS is a Type (not Expression). Postfix precedence comes from the first
    // element (ReqRef Expression : Relational) while the RHS is a plain Ref("Type") parsed at
    // minPrecedence 0, so all Type postfix ranks (TypeArray/TypePointer) apply. Same
    // first-element-ReqRef pattern as Type's own postfixes (above). Roslyn: Precedence.Relational.
    | TypeIs        = Expression : Relational "is" Type
    | TypeAs        = Expression : Relational "as" Type
    | Equal         = Expression "==" Expression : Equality
    | NotEqual      = Expression "!=" Expression : Equality
    | BitAnd        = Expression "&"  Expression : LogicalAnd
    | BitXor        = Expression "^"  Expression : LogicalXor
    | BitOr         = Expression "|"  Expression : LogicalOr
    | And           = Expression "&&" Expression : CondAnd
    | Or            = Expression "||" Expression : CondOr
    | Conditional   = Expression "?" Expression ":" Expression : Conditional
    | Assign        = Expression "="  Expression : Assignment, right
    | Comma         = Expression ","  Expression : Comma;

Primary =
    | "true"
    | "false"
    | "null"
    | "this"
    // Reserved words are not identifiers (C# 1.0): without this guard `new`/`typeof`/`sizeof`
    // would fall back to Identifier and swallow e.g. `typeof(int, int)` as an invocation.
    | IdentifierName = !ReservedKeyword Identifier
    // T2.3.3: predefined type name as the start of a member-access expression — int.Parse(),
    // string.Format("a"), double.MaxValue, char.IsLetter('a'). A BARE predefined type is NOT an
    // expression: the "." Identifier is REQUIRED here, so `int` alone still matches no Primary
    // alternative and fails (requirement 2). Further postfixes (`()`, `.x`, `[i]`) are handled by
    // the PostfixOp* loop in PrimaryExpr. Roslyn ParsePrimaryExpressionWithoutPostfix
    // (LanguageParser.cs:12078-12093): a predefined-type token is a valid expression-start only
    // when immediately followed by "." (else ERR_InvalidExprTerm); the member name is a true
    // identifier (non-reserved). The IdentifierName guard above is untouched, so `new`/`typeof`/
    // `sizeof` still cannot be bare identifiers (requirement 3).
    | PredefinedMember = PredefinedType "." !ReservedKeyword Identifier
    // T2.1.3: `base` is a reserved keyword (ReservedKeyword) with no Primary alternative, so
    // `base.Foo()` in a method body (e.g. `class C : B { void M() { base.Foo(); } }`) would NOT
    // parse (D2-type defect, like `int.Parse()`). Fix mirrors PredefinedMember (T2.3.3): `base` is a
    // valid expression-start only when immediately followed by "." + a true identifier. `base` alone
    // is NOT an expression (C#: `base` is only valid as `base.Member`). The IdentifierName guard above
    // is untouched. Known boundary: `base[0]` (base indexer) does not parse (needs "."), consistent
    // with the PredefinedMember `int[5]` boundary (T2.3.3).
    | BaseMember = "base" "." !ReservedKeyword Identifier
    | StringLiteral
    | VerbatimStringLiteral
    | CharLiteral
    | DecInt  = DecimalIntegerLiteral IntegerSuffix?
    | HexInt  = HexIntegerLiteral  IntegerSuffix?
    | Real    = DecimalRealLiteral Exponent? RealSuffix?
    | Parens  = "(" Expression ")"
    // T2.3.1: self-contained primary units (Roslyn ParsePrimaryExpressionWithoutPostfix).
    | NewExpr = "new" NewBody
    | SizeOf  = "sizeof" "(" Type ")"
    | TypeOf  = "typeof" "(" Type ")"
    // T3.7.1: typed default `default ( Type )` (C# 1.0, Roslyn ParseDefaultExpression typed branch,
    // LanguageParser.cs:12633: `default` + `(` + ParseType() + `)`). `default` is a reserved keyword
    // (ReservedKeyword), so this is the SOLE Primary match for a `default ( ... )` expression (no
    // equal-length tie with any other Primary alternative). It is the C# 1.0 counterpart of the Cs7
    // `default` LITERAL (T3.7.1, `default` alone, Cs7.grammar): at v7 the literal is `default` (no `(`),
    // and `default ( Type )` is this typed form. Added in T3.7.1 because the task's test list requires
    // `default(int)` to parse at v1–v6 (it did not parse at any version before — see progress doc).
    | DefaultTyped = "default" "(" Type ")"
    // T2.3.4: checked/unchecked expressions (Roslyn ParseCheckedOrUncheckedExpression,
    // LanguageParser.cs:12677-12689). `checked ( expr )` / `unchecked ( expr )` — self-contained
    // primary units (like Parens). The inner Expression is a FULL TDOPP expression (Roslyn
    // ParseExpressionForParenthesizedConstruct → ParseExpressionCore), so `checked (x + y * z)`
    // checks the whole `x + y * z`. Leading tokens `checked`/`unchecked` are reserved keywords
    // (ReservedKeyword), distinct from Parens (which starts with "(") → no equal-length tie.
    // Precedence: primary (highest); `checked (x) + 1` → (checked (x)) + 1 (root Add).
    | CheckedExpr   = "checked"   "(" Expression ")"
    | UncheckedExpr = "unchecked" "(" Expression ")";

PostfixOp =
    | MemberAccess = "." Identifier
    | Indexer      = "[" (Expression; ",")* "]"
    | Invocation   = "(" (Expression; ",")* ")"
    | PostInc      = "++"
    | PostDec      = "--";

// === T2.3.1: new-экспрессии C# 1.0 (Roslyn ParseArrayOrObjectCreationExpression,
// LanguageParser.cs:13383-13428). Две формы:
//   array creation:  new BaseType [sizes] {initializer}?   (тип — массивный)
//   object creation: new BaseType (argument-list)          (тип — немассивный)
// C# 1.0: без object/collection-инициализаторов (CS3); array-инициализатор — C# 1.0.
// `new T` без скобок/размеров/инициализатора — parse-ошибка (ERR_BadNewExpr, CS1526).
NewBody =
    | ArrayCreation  = NewBaseType NewArrayRank ArrayInitializer?
    | ObjectCreation = NewBaseType ArgumentList;

// Базовый тип для new: немассивный, не-указательный (new-указателя нет в C# 1.0).
NewBaseType =
    | PredefinedType
    | QualifiedName;

// Ранг-спецификатор в expression-контексте new: `[` + expression-list + `]` (размеры) или `[]`
// (опущенный размер). В отличие от ArrayRankSpecifier (тип-контекст, только запятые) — здесь
// размеры — полные выражения (Roslyn ParseArrayRankSpecifier, LanguageParser.cs:7860-7918).
NewArrayRank = "[" (Expression; ",")* "]";

// Array-инициализатор: `{` expression-list? `}` (C# 1.0).
ArrayInitializer = "{" (Expression; ",")* "}";

// Argument-list: `(` expression-list? `)` (пустой список допустим: `new Foo()`).
ArgumentList = "(" (Expression; ",")* ")";

// === T2.2.1: операторы C# 1.0 — Block + простые операторы. Первый из трёх подпунктов:
// T2.2.1 (simple) → T2.2.2 (if/while/do-while/for/foreach) → T2.2.3 (switch/try/using/lock/checked).
// Statement — центральное правило-union; T2.2.2/T2.2.3 будут ДОБАВЛЯТЬ альтернативы (Block уже есть,
// т.к. блок — оператор в C# и нужен для вложенных блоков).
// Семантика по Roslyn LanguageParser (C:\RSDN\roslyn, main): ParseStatement/ParseStatementCore
// (8184-8460), ParseBlock (9098), ParseLabeledStatement (10466), ParseLocalDeclarationStatement
// (10482), ParseBreakStatement (9330), ParseContinueStatement (9339), ParseGotoStatement (9947),
// ParseReturnStatement (10113), ParseThrowStatement (10308).
//
// Disambiguation «локальная декларация vs expression-statement» — longest-match: декларация
// начинается с ДВУХ имён подряд (Type Identifier), что никогда не является выражением;
// expression-statement — одно выражение, что никогда не является Type Identifier. Пары
// альтернатив не дают равной длины → тай-брейк «первый выигрывает» не задействуется.
// См. docs/CSharpParserPlan-progressT2.2.1.md.

Block = "{" Statement* "}";

Statement =
    | Block
    | LabeledStatement
    | EmptyStatement
    | ExpressionStatement
    | LocalVariableDeclaration
    | ReturnStatement
    | ThrowStatement
    | BreakStatement
    | ContinueStatement
    | GotoStatement
    | IfStatement
    | WhileStatement
    | DoWhileStatement
    | ForStatement
    | ForEachStatement
    | SwitchStatement
    | TryStatement
    | UsingStatement
    | LockStatement
    | CheckedStatement
    | UncheckedStatement;

// label: Identifier ":" Statement — метка = истинный идентификатор (не ключевое слово).
// Roslyn IsPossibleLabeledStatement (8493): PeekToken(1)==Colon && IsTrueIdentifier.
LabeledStatement = !ReservedKeyword Identifier ":" Statement;

// Пустой оператор ";" (Roslyn ParseStatementCore case SemicolonToken, 8347).
EmptyStatement = ";";

// Выражение-оператор: Expression ";" (Roslyn ParseExpressionStatement, 11037).
ExpressionStatement = Expression ";";

// Локальная декларация: Type VariableDeclarator ("," VariableDeclarator)* ";"
// (Roslyn ParseLocalDeclarationStatement 10482 → VariableDeclaration + Semicolon, 10568-10574).
LocalVariableDeclaration = Type VariableDeclarator ("," VariableDeclarator)* ";";

// VariableDeclarator: Identifier ("=" Expression)? (Roslyn ParseVariableDeclarator 5481,
// name + EqualsValueClause, 5704-5709/5733). Имя — не ключевое слово.
VariableDeclarator = !ReservedKeyword Identifier ("=" Expression)?;

// return Expression? ";" (Roslyn ParseReturnStatement 10113; без ref-возврата — CS7).
ReturnStatement = "return" Expression? ";";

// throw Expression? ";" (Roslyn ParseThrowStatement 10308; throw; — rethrow, C# 1.0).
ThrowStatement = "throw" Expression? ";";

// break ";" (Roslyn ParseBreakStatement 9330; C# 1.0 — без метки).
BreakStatement = "break" ";";

// continue ";" (Roslyn ParseContinueStatement 9339; C# 1.0 — без метки).
ContinueStatement = "continue" ";";

// goto ( Identifier | "case" Constant | "default" ) ";" (Roslyn ParseGotoStatement 9947).
// C# 1.0: case-метка — константное выражение (Constant); метка-идентификатор — не ключевое слово.
GotoStatement =
    | GotoLabel = "goto" !ReservedKeyword Identifier ";"
    | GotoCase = "goto" "case" Constant ";"
    | GotoDefault = "goto" "default" ";";

// === T2.2.2: циклы и условные операторы C# 1.0 — if / while / do-while / for / foreach.
// Второй из трёх подпунктов операторов (T2.2.1 simple → T2.2.2 → T2.2.3 switch/try/using/lock/checked).
// Семантика по Roslyn LanguageParser (C:\RSDN\roslyn, main): ParseIfStatement (10013),
// ParseWhileStatement (10454), ParseDoStatement (9524), ParseForStatement (9586),
// ParseForEachStatement (9728).
//
// Dangling else: `if (a) if (b) c; else d;` — else связывается с НАИБЛИЖАЙШИМ (внутренним) if.
// Механизм (declarative, без lookahead): `("else" Statement)?` — Optional (Parser.cs ParseOptional
// 543-551) ЖАДНЫЙ: если `else` присутствует, он поглощается ТЕКУЩИМ if. then-Statement внутреннего if
// парсится ПЕРЕД тем, как внешний if проверяет свой else, поэтому внутренний if «съедает» else
// (внутренний then-Statement `c;` останавливается на первом `;` и не добирается до else). Тай-брейк не
// возникает: then-Statement, начинающийся с `if`, совпадает только с IfStatement (остальные
// альтернативы Statement начинаются с `{`/идентификатора/`;`/`return`/...). См. progressT2.2.2.

IfStatement = "if" "(" Expression ")" Statement ("else" Statement)?;

WhileStatement = "while" "(" Expression ")" Statement;

DoWhileStatement = "do" Statement "while" "(" Expression ")" ";";

ForStatement = "for" "(" ForInit? ";" Expression? ";" Expression? ")" Statement;

// for-initialization (C# 1.0): local-variable-declaration | expression-list?.
// Roslyn ParseForStatement.eatVariableDeclarationOrInitializers (9628): декларация ИЛИ список выражений.
// Формальная запись задачи (Expression? ";") упрощена: тест `for (int i = 0; ...)` требует
// декларативной формы в init, поэтому ForInit = декларация | Expression. Дисамбигуация
// декларация-vs-выражение — та же longest-match, что в LocalVariableDeclaration vs ExpressionStatement
// (T2.2.1): два имени подряд — только декларация, одно выражение — только Expression.
ForInit =
    | ForVariableDeclaration = Type VariableDeclarator ("," VariableDeclarator)*
    | Expression;

// foreach ( type identifier in expression ) statement (C# 1.0; deconstruction — C# 7, вне скоупа).
// Имя переменной — истинный идентификатор (не ключевое слово), guard как в VariableDeclarator.
ForEachStatement = "foreach" "(" Type !ReservedKeyword Identifier "in" Expression ")" Statement;

// === T2.2.3: сложные операторы C# 1.0 — switch / try / using / lock / checked / unchecked.
// Третий (последний) подпункт операторов (T2.2.1 simple → T2.2.2 if/while/do/for/foreach → T2.2.3).
// Семантика по Roslyn LanguageParser (C:\RSDN\roslyn, main): ParseSwitchStatement (10160),
// ParseSwitchSection (10236), ParseTryStatement (9348), ParseCatchClause (9424), ParseUsingStatement
// (10327), ParseLockStatement (10101), ParseCheckedStatement (9507).
//
// Каждая новая альтернатива начинается со СВОЕГО reserved-keyword (switch/try/using/lock/checked/
// unchecked), которого нет у существующих альтернатив Statement → disambiguation по ведущему токену,
// равных тай-брейков нет.
//
// Ограничение CsNitra-метаграмматики: `|` допустим только между top-level альтернативами правила, НЕ
// внутри группы `( ... )` (Group оборачивает ОДНО RuleExpression, CsNitraParser.cs:103). Поэтому формы
// `( A | B )` вынесены в правила-union: SwitchLabel, TryTail, CheckedBody, ResourceAcquisition.
// См. docs/CSharpParserPlan-progressT2.2.3.md.

// switch ( Expression ) { SwitchSection* } (Roslyn ParseSwitchStatement 10160; управляющее выражение
// в скобках, C# 1.0 — без tuple-формы C# 7).
SwitchStatement = "switch" "(" Expression ")" "{" SwitchSection* "}";

// Секция: ( CaseLabel | DefaultLabel )+ Statement* — одна/неск. меток (стек `case 1: case 2:`), затем
// операторы. Roslyn ParseSwitchSection (10236): do{label}while(IsPossibleSwitchSection), затем
// ParseStatements(stopOnSwitchSections: true). Statement* останавливается перед следующей case/default,
// т.к. они reserved keywords и не являются началом Statement. SwitchLabel+ — one-or-more, поэтому секция
// ОБЯЗАНА начинаться с метки: `switch (x) { y = 1; }` (оператор без метки) не парсится.
SwitchSection = SwitchLabel+ Statement*;

// Метка секции: case-метка (константа) ИЛИ default-метка (Roslyn: case → ParseExpressionOrPatternForSwitch,
// C# 1.0 — константное выражение, без паттернов/when — C# 7; default → DefaultSwitchLabel).
SwitchLabel =
    | CaseLabel
    | DefaultLabel;

// case Constant ":" (C# 1.0: константное выражение; Constant — int/char/string/bool + унарный знак).
CaseLabel = "case" Constant ":";

// default ":" (Roslyn DefaultSwitchLabel, 10289-10291).
DefaultLabel = "default" ":";

// try Block ( CatchClause+ FinallyClause? | FinallyClause ) (Roslyn ParseTryStatement 9348).
// Обязательность catch/finally: Roslyn даёт ERR_ExpectedEndTry, если нет ни catch, ни finally (9393-9402)
// → `try { }` невалиден. finally — один, после catch* → finally-до-catch / две finally невалидны.
TryStatement = "try" Block TryTail;

// Хвост try: catch+ (с опц. finally) ИЛИ finally. `|` в группе не выразимо → отдельное правило.
// Альтернативы взаимно исключают друг друга (ведущий catch vs finally) → тай-брейков нет.
TryTail =
    | CatchClauses = CatchClause+ FinallyClause?
    | FinallyClause;

// catch ( Type Identifier? )? Block (Roslyn ParseCatchClause 9424). Скобки с типом/именем ОПЦИОНАЛЬНЫ:
// `catch { }` (catch-all, Declaration == null) валиден (TestTryCatchWithNoExceptionDeclaration, 1282).
// Имя — истинный идентификатор (guard), опционально. when-фильтр — C# 6, вне скоупа C# 1.0.
CatchClause = "catch" ("(" Type !ReservedKeyword Identifier? ")")? Block;

// finally Block (Roslyn FinallyClause, 9388-9390).
FinallyClause = "finally" Block;

// using ( ResourceAcquisition ) Statement (Roslyn ParseUsingStatement 10327; C# 1.0 — только
// statement-форма, using-декларация `using T a = b;` — C# 8, вне скоупа).
UsingStatement = "using" "(" ResourceAcquisition ")" Statement;

// ResourceAcquisition: локальная декларация (Type VariableDeclarator*) ИЛИ Expression. Дисамбигуация
// декларация-vs-выражение — longest-match (как ForInit, T2.2.2): два имени подряд — только декларация,
// одно выражение — только Expression. Тай-брейков нет.
ResourceAcquisition =
    | ResourceDeclaration = Type VariableDeclarator ("," VariableDeclarator)*
    | Expression;

// lock ( Expression ) Statement (Roslyn ParseLockStatement 10101).
LockStatement = "lock" "(" Expression ")" Statement;

// checked/unchecked ( Block | ExpressionStatement ) (Roslyn ParseCheckedStatement 9507; C# grammar:
// checked_statement: checked block | checked expression_statement). `{` ведёт → Block, иначе ExpressionStatement.
// ВАЖНО: checked-ВЫРАЖЕНИЕ `checked ( expr )` (напр. `int w = checked (x + y);`) — это Expression, НЕ
// statement; НЕ добавлено здесь (T2.3 follow-up, см. progressT2.2.3). Здесь `checked (x = y + z);` моделируется
// как `checked` + ExpressionStatement `(x = y + z);` (упрощение; см. Boundary decisions).
CheckedStatement = "checked" CheckedBody;

// unchecked — аналог checked.
UncheckedStatement = "unchecked" CheckedBody;

// Тело checked/unchecked: Block ИЛИ ExpressionStatement. `|` в группе не выразимо → отдельное правило.
// `{` ведёт → Block, иначе ExpressionStatement. Взаимно исключают друг друга → тай-брейков нет.
CheckedBody =
    | Block
    | ExpressionStatement;
